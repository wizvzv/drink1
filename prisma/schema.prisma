generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
}

enum SendStatus {
  success
  failed
}

model User {
  id        String   @id @default(uuid())
  nickname  String?
  role      UserRole @default(user)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  binding         WeChatBinding?
  reminderConfig  ReminderConfig?
  sendLogs        SendLog[]
  drinkRecords    DrinkRecord[]

  @@map("users")
}

model WeChatBinding {
  id           String    @id @default(uuid())
  userId       String    @unique @map("user_id")
  botToken     String    @map("bot_token")
  ilinkBotId   String    @map("ilink_bot_id")
  ilinkUserId  String    @map("ilink_user_id")
  contextToken String?   @map("context_token")
  isActive     Boolean   @default(true) @map("is_active")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wechat_bindings")
}

model ReminderConfig {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  isActive  Boolean  @default(true) @map("is_active")
  timezone  String   @default("Asia/Shanghai")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  intervalRule IntervalRule?
  fixedTimes  FixedTimeRule[]

  @@map("reminder_configs")
}

model IntervalRule {
  id               String @id @default(uuid())
  reminderConfigId String @unique @map("reminder_config_id")
  intervalMinutes  Int    @map("interval_minutes")
  startTime        String @map("start_time") // HH:mm
  endTime          String @map("end_time")   // HH:mm

  reminderConfig ReminderConfig @relation(fields: [reminderConfigId], references: [id], onDelete: Cascade)

  @@map("interval_rules")
}

model FixedTimeRule {
  id               String @id @default(uuid())
  reminderConfigId String @map("reminder_config_id")
  time             String // HH:mm

  reminderConfig ReminderConfig @relation(fields: [reminderConfigId], references: [id], onDelete: Cascade)

  @@map("fixed_time_rules")
}

model SendLog {
  id             String     @id @default(uuid())
  userId         String     @map("user_id")
  sentAt         DateTime   @default(now()) @map("sent_at")
  messageContent String     @map("message_content")
  status         SendStatus @default(success)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@map("send_logs")
}

model DrinkRecord {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  recordedAt   DateTime @default(now()) @map("recorded_at")
  replyMessage String   @map("reply_message")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@map("drink_records")
}
